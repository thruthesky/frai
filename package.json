{
  "name": "frai",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "main": "dist/main/index.js",
  "description": "여러 인공지능을 한 화면에서 — 무료 인공지능 개발 툴",
  "author": "PES",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json --noEmit",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run check && npm run check:security && npm run check:theme && npm run test",
    "dist:mac": "npm run build && electron-builder --mac --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist": "npm run build && electron-builder --mac --arm64 --win --x64",
    "check:theme": "node scripts/check-theme.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
